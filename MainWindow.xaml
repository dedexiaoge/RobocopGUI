<Window x:Class="RobocopyGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Robocopy GUI"
        Width="920" Height="1020"
        MinWidth="700" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="#1e1e1e">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#2d2d2d"/>
            <Setter Property="Foreground" Value="#e0e0e0"/>
            <Setter Property="BorderBrush" Value="#555"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#cccccc"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#3c3c3c"/>
            <Setter Property="Foreground" Value="#e0e0e0"/>
            <Setter Property="BorderBrush" Value="#555"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#cccccc"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#cccccc"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#252526" BorderBrush="#3c3c3c" BorderThickness="0,0,0,1" Padding="28,16">
            <DockPanel>
                <Button Content="重置" DockPanel.Dock="Right" Click="BtnReset_Click" VerticalAlignment="Center"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Robocopy GUI" FontSize="22" FontWeight="SemiBold" Foreground="#e0e0e0"/>
                    <TextBlock Text="Windows 文件复制工具图形界面" FontSize="13" Foreground="#808080" Margin="0,2,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="860" HorizontalAlignment="Center" Margin="28,16">

                <!-- Source & Destination -->
                <Border Background="#2d2d2d" BorderBrush="#404040" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="源和目标路径" FontSize="15" FontWeight="SemiBold" Foreground="#e0e0e0" Margin="0,0,0,14"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="68"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="源路径" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" x:Name="TxtSource" Margin="8,0,8,0"/>
                            <Button Grid.Column="2" Content="浏览" Click="BtnBrowseSource_Click"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="68"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="目标路径" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" x:Name="TxtDestination" Margin="8,0,8,0"/>
                            <Button Grid.Column="2" Content="浏览" Click="BtnBrowseDestination_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Copy Mode & Subdirectories -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="#2d2d2d" BorderBrush="#404040" BorderThickness="1" CornerRadius="8" Padding="20">
                        <StackPanel>
                            <TextBlock Text="复制模式" FontSize="15" FontWeight="SemiBold" Foreground="#e0e0e0" Margin="0,0,0,8"/>
                            <RadioButton x:Name="RbCopyAll" Content="全部文件" GroupName="CopyMode" IsChecked="True" Checked="Option_Changed"/>
                            <RadioButton x:Name="RbMirror" Content="镜像 /MIR" GroupName="CopyMode" Checked="Option_Changed"/>
                            <RadioButton x:Name="RbMove" Content="移动 /MOV" GroupName="CopyMode" Checked="Option_Changed"/>
                            <RadioButton x:Name="RbMovePurge" Content="移动并清理 /MOVE" GroupName="CopyMode" Checked="Option_Changed"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Background="#2d2d2d" BorderBrush="#404040" BorderThickness="1" CornerRadius="8" Padding="20">
                        <StackPanel>
                            <TextBlock Text="子目录" FontSize="15" FontWeight="SemiBold" Foreground="#e0e0e0" Margin="0,0,0,8"/>
                            <RadioButton x:Name="RbNoSubdir" Content="不复制子目录" GroupName="SubdirMode" Checked="Option_Changed"/>
                            <RadioButton x:Name="RbSubdirAll" Content="所有子目录 /S" GroupName="SubdirMode" IsChecked="True" Checked="Option_Changed"/>
                            <RadioButton x:Name="RbSubdirEmpty" Content="含空子目录 /E" GroupName="SubdirMode" Checked="Option_Changed"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Filters -->
                <Border Background="#2d2d2d" BorderBrush="#404040" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="过滤器" FontSize="15" FontWeight="SemiBold" Foreground="#e0e0e0" Margin="0,0,0,12"/>
                        <TextBlock Text="文件筛选" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtFileFilter" Margin="0,0,0,10" TextChanged="Option_Changed"/>
                        <TextBlock Text="排除文件" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtExcludeFiles" Margin="0,0,0,10" TextChanged="Option_Changed"/>
                        <TextBlock Text="排除目录" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtExcludeDirs" TextChanged="Option_Changed"/>
                    </StackPanel>
                </Border>

                <!-- Advanced -->
                <Border Background="#2d2d2d" BorderBrush="#404040" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="高级选项" FontSize="15" FontWeight="SemiBold" Foreground="#e0e0e0" Margin="0,0,0,12"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="重试次数 (/R:n)" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtRetries" Text="3"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="等待秒数 (/W:n)" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtWait" Text="5"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="线程数 (/MT:n)" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtThreads" Text="8"/>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" x:Name="ChkRestartable" Content="可重启模式 (/Z)" IsChecked="True"/>
                            <CheckBox Grid.Column="1" x:Name="ChkBackup" Content="备份模式 (/B)"/>
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="日志文件路径" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtLogFile"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="浏览" Click="BtnBrowseLog_Click" VerticalAlignment="Bottom"/>
                        </Grid>
                        <CheckBox x:Name="ChkAppendLog" Content="追加到日志（/LOG+ 代替 /LOG）" IsChecked="True" Margin="0,0,0,12"/>
                        <TextBlock Text="附加参数" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtExtraArgs"/>
                    </StackPanel>
                </Border>

                <!-- Command Preview -->
                <Border Background="#2d2d2d" BorderBrush="#404040" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,12">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <Button x:Name="BtnCopyCmd" Content="复制命令" DockPanel.Dock="Right" Click="BtnCopyCommand_Click" FontSize="12"/>
                            <TextBlock Text="命令预览" FontSize="15" FontWeight="SemiBold" Foreground="#e0e0e0" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Border Background="#1a1a1a" CornerRadius="4" Padding="12,10" BorderBrush="#555" BorderThickness="1">
                            <TextBlock x:Name="TxtCommandPreview" FontFamily="Consolas" FontSize="13" Foreground="#4EC9B0" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Action Buttons -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="BtnRun" Grid.Column="0" Content="执行" Click="BtnRun_Click" Background="#0078D4" Foreground="White" Padding="24,8" FontSize="14" FontWeight="SemiBold"/>
                    <Button x:Name="BtnDryRun" Grid.Column="2" Content="模拟执行" Click="BtnDryRun_Click" Padding="18,8" FontSize="14"/>
                    <Button x:Name="BtnCancel" Grid.Column="4" Content="取消" Click="BtnCancel_Click" IsEnabled="False" Padding="18,8" FontSize="14"/>
                </Grid>

                <!-- Output -->
                <Border Background="#2d2d2d" BorderBrush="#404040" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="输出日志" FontSize="15" FontWeight="SemiBold" Foreground="#e0e0e0" Margin="0,0,0,8"/>
                        <Border Background="#0d0d0d" CornerRadius="4" BorderBrush="#555" BorderThickness="1">
                            <ScrollViewer x:Name="OutputScroller" MaxHeight="380" VerticalScrollBarVisibility="Auto">
                                <TextBlock x:Name="TxtOutput" FontFamily="Consolas" FontSize="12" Foreground="#b0b0b0" TextWrapping="Wrap" Padding="12,8" Text="等待执行..."/>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="#252526" BorderBrush="#3c3c3c" BorderThickness="0,1,0,0" Padding="28,10">
            <DockPanel>
                <TextBlock x:Name="TxtExitCode" DockPanel.Dock="Right" Text="退出码: --" VerticalAlignment="Center" FontSize="12.5" Foreground="#808080"/>
                <TextBlock x:Name="TxtElapsed" DockPanel.Dock="Right" Text="耗时: 00:00:00" VerticalAlignment="Center" FontSize="12.5" Margin="0,0,24,0" Foreground="#808080"/>
                <ProgressBar x:Name="ProgressBar" DockPanel.Dock="Left" IsIndeterminate="False" Width="60" Height="10" Margin="0,0,10,0" Visibility="Hidden"/>
                <TextBlock x:Name="TxtStatus" Text="就绪" VerticalAlignment="Center" FontSize="12.5" Foreground="#808080"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>